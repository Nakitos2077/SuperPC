{
  "manifest_version": 3,
  "name": "Meet Assistant (Claude)",
  "version": "1.2.0",
  "description": "Слушает Google Meet через субтитры и показывает подсказки Claude поверх вкладки Мита.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://meet.google.com/*", "https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Meet Assistant — настройки" }
}

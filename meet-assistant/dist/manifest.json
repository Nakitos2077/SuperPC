{
  "manifest_version": 3,
  "name": "Meet Assistant (Claude)",
  "version": "1.6.0",
  "description": "Слушает встречу в Google Meet или Zoom (в браузере) и показывает подсказки Claude поверх вкладки.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/wc/*",
    "https://api.telegram.org/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Meet Assistant — настройки"
  }
}